<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.lima-proxy-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/herryzheng/.lima-proxy/lima-proxy-daemon.sh</string>
        <string>tunnel</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/herryzheng</string>
        <key>USER</key>
        <string>herryzheng</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LIMA_PORT</key>
        <string>17890</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>3</integer>
    <key>StandardOutPath</key>
    <string>/Users/herryzheng/.lima-proxy/logs/tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/herryzheng/.lima-proxy/logs/tunnel.log</string>
</dict>
</plist>
