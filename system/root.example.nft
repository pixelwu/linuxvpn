table inet mini_work_guard {
  set upstream4 {
    type ipv4_addr
    elements = { 1.2.3.4 }
  }

  chain proxy_out {
    oifname "mw-host" ip daddr 10.203.0.2 tcp sport 17890 ct state established ct direction reply counter accept
    oifname "lo" ip daddr 10.203.0.1 tcp sport 17890 ct state established ct direction reply counter accept
    ip daddr @upstream4 tcp dport 443 ct state established,new counter accept
    counter drop
  }

  chain input {
    type filter hook input priority -10; policy drop;
    iifname "lo" accept
    ct state established,related accept
    iifname "eth0" ip saddr 192.168.5.2 tcp dport 22 ct state new counter accept
    iifname "eth0" ip saddr 192.168.5.2 udp sport 67 udp dport 68 counter accept
    iifname "mw-host" ip saddr 10.203.0.2 tcp dport 17890 ct state new counter accept
  }

  chain output {
    type filter hook output priority -10; policy drop;
    meta skuid 1001 counter drop
    meta skuid 997 jump proxy_out
    meta skuid 999 oifname "mw-host" ip daddr 10.203.0.2 tcp dport 22 ct state established,new counter accept
    oifname "lo" accept
    oifname "eth0" ip daddr 192.168.5.2 tcp sport 22 ct state established ct direction reply counter accept
    oifname "eth0" ip daddr { 192.168.5.2, 255.255.255.255 } udp sport 68 udp dport 67 counter accept
    counter drop
  }

  chain forward {
    type filter hook forward priority -10; policy drop;
  }
}
